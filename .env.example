# Public values: safe in browser. Use your actual production URL with no trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret values: SERVER ONLY. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATION_ENCRYPTION_KEY=
CRON_SECRET=
# Choose available text models that support function tools. Rates MUST match your models.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_INPUT_USD_PER_M=
OPENAI_OUTPUT_USD_PER_M=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_INPUT_USD_PER_M=
ANTHROPIC_OUTPUT_USD_PER_M=
# Your current accounting conversion rate, including any FX overhead you intend to absorb.
USD_TO_AUD=
# Measured execution cost in AUD per second. 0 means platform absorbs execution overhead.
EXECUTION_AUD_PER_SECOND=0
# Keep billing disabled until the setup and live-provider checks in SETUP.md are complete.
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_SIX=
STRIPE_PRICE_PRO_YEAR=
STRIPE_PRICE_PRO_THREE=
STRIPE_PRICE_PRO_TEN=
STRIPE_PRICE_EXECUTIVE_MONTH=
STRIPE_PRICE_EXECUTIVE_SIX=
STRIPE_PRICE_EXECUTIVE_YEAR=
STRIPE_PRICE_EXECUTIVE_THREE=
STRIPE_PRICE_EXECUTIVE_TEN=
STRIPE_TOPUP_100=
STRIPE_TOPUP_300=
STRIPE_TOPUP_1000=
# One platform/team webhook secret; other teams can use manual deployment refresh.
VERCEL_WEBHOOK_SECRET=
